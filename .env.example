# LLM Provider Configuration
# Choose one: anthropic, openai, or databricks
LLM_PROVIDER=databricks

# Anthropic (Claude) Configuration
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI (GPT-4) Configuration
# OPENAI_API_KEY=your-openai-api-key-here

# Databricks Model Serving Configuration
# Option 1: Full endpoint URL
DATABRICKS_SERVING_ENDPOINT=https://your-workspace.cloud.databricks.com/serving-endpoints/your-endpoint-name/invocations

# Option 2: Host + Endpoint name (alternative to full URL)
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_ENDPOINT_NAME=your-endpoint-name
# DATABRICKS_TOKEN=your-databricks-token  # Only needed for external calls, not in Databricks Apps

# Gradio Server Configuration (optional)
# GRADIO_SERVER_NAME=0.0.0.0
# GRADIO_SERVER_PORT=7860
